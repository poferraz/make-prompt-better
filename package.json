{
  "name": "make-prompt-better",
  "version": "4.5.1",
  "description": "Research-grounded prompt and agent-context optimization with four task-proportional modes, requirement preservation, and deterministic linting.",
  "type": "module",
  "main": "bin/cli.mjs",
  "bin": {
    "make-prompt-better": "./bin/cli.mjs",
    "lint-context": "./lint_context.py"
  },
  "files": [
    "make-prompt-better",
    ".claude-plugin",
    ".github/CONTRIBUTING.md",
    "assets",
    "bin",
    "scripts/lint-prompt.mjs",
    "install.sh",
    "lint_context.py",
    "docs/installation.md",
    "docs/benchmark-runs.md",
    "docs/demo.md",
    "docs/claims.md",
    "docs/methodology.md",
    "docs/tradeoffs.md",
    "docs/when-to-use.md",
    "docs/task-classification.md",
    "docs/releasing.md",
    "research/benchmark/v4/SUMMARY_V4_ALL_MODELS.md",
    "research/benchmark/v4/EVALUATION_PROMPT_V4.md",
    "research/benchmark/v4/results/AGGREGATED_METRICS.md",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CITATION.cff",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE",
    "docs/quickstart.md",
    "docs/compatibility.md",
    "docs/testing.md",
    "docs/evidence/2026-11-06/codex-discovery.json",
    "docs/npm-publishing.md",
    "docs/evidence/2026-11-06/v4.4.0-candidate-discovery.json",
    "docs/evidence/2026-11-06/npm-setup.json",
    "docs/evidence/2026-11-06/v4.5.0-npm-verification.json",
    "docs/evidence/2026-11-07/v4.5.1-source-verification.json",
    "docs/evidence/2026-11-07/v4.5.1-npm-verification.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "npm run verify:fast && npm test",
    "verify:fast": "python3 scripts/validate_repo.py && python3 scripts/check-release.py && npm run lint && bash -n install.sh",
    "test": "python3 -m unittest discover -s research/benchmark/v4 -p 'test_*.py' -v && node scripts/lint-prompt.mjs --self-test && python3 research/benchmark/v4/blind_stats_engine.py && python3 -m unittest discover -s tests -v",
    "lint": "python3 lint_context.py --self-test && python3 lint_context.py CLAUDE.md AGENTS.md && node scripts/lint-prompt.mjs CLAUDE.md AGENTS.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poferraz/make-prompt-better.git"
  },
  "keywords": [
    "prompt-engineering",
    "prompt-compiler",
    "semi-formal-reasoning",
    "agent-skills",
    "agentskills",
    "claude-code",
    "gemini-cli",
    "codex",
    "cursor",
    "context-engineering",
    "harness-engineering"
  ],
  "author": "Paulo Ferraz",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
